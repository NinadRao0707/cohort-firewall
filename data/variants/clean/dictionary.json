    "age_at_diagnosis": {
      "type": "numeric",
      "role": "demographic",
      "timing": "baseline",
      "description": "Age in years at diagnosis"
    },
    "sex": {
      "type": "categorical",
      "role": "demographic",
      "timing": "baseline",
      "description": "Recorded sex"
    },
    "race": {
      "type": "categorical",
      "role": "demographic",
      "timing": "baseline",
      "description": "Recorded race category"
    },
    "ethnicity": {
      "type": "categorical",
      "role": "demographic",
      "timing": "baseline",
