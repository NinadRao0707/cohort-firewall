    "her2_status": {
      "type": "categorical",
      "role": "feature",
      "timing": "baseline",
      "description": "HER2 status"
    },
    "tumor_size_mm": {
      "type": "numeric",
      "role": "feature",
      "timing": "baseline",
      "description": "Tumor size at diagnosis (mm)"
